# Replace all example values before adding these sections to ~/.aws/config.
# Do not commit your personal AWS config or credentials.

[profile example-source]
sso_session = example-sso
sso_account_id = 123456789012
sso_role_name = ExampleSourceRole
region = ap-southeast-2

[profile example-agent]
credential_process = /absolute/path/to/readonly-agent.sh example-source arn:aws:iam::123456789012:role/ExampleReadOnlyRole
region = ap-southeast-2

[sso-session example-sso]
sso_start_url = https://example.awsapps.com/start
sso_region = ap-southeast-2